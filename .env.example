# Copy to .env (never commit .env) and export before starting the backend,
# e.g.  set -a; source .env; set +a; uvicorn backend.main:app --port 8000

# ASR: auto | whisper | none
ASR_ENGINE=auto
WHISPER_MODEL=dsfsi-anv/whisper-small-anv-zulu-first-batch
# WHISPER_LANGUAGE=            # token your fine-tuning notebook used, if not the saved "en"
WHISPER_NUM_BEAMS=5            # 1 = greedy (17.23% WER on AST), 5 = beam search (16.25%)
WHISPER_NO_REPEAT_NGRAM=0
WHISPER_REPETITION_PENALTY=1.0

# Branch A: auto | dev-rules | nllb-rules | hf | zero-shot
# auto = hf if BRANCH_A_CLASSIFIER is set, else nllb-rules when the ML libraries are installed
BRANCH_A_ENGINE=auto
TRANSLATOR_MODEL=facebook/nllb-200-distilled-600M
# BRANCH_A_CLASSIFIER=models/branch_a_classifier

# Branch B: auto | dev-rules | inkubalm
BRANCH_B_ENGINE=auto
INKUBALM_MODEL=lelapa/InkubaLM-0.4B
# INKUBALM_ADAPTER=models/inkubalm_intent_lora

# DEVICE=auto                  # cuda | mps | cpu
# PEPPER_EXECUTOR_URL=http://127.0.0.1:8765
# CORS_ORIGINS=*
